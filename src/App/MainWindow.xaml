<Window
    x:Class="ANetworkScanner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ANetworkScanner.App.ViewModels"
    xmlns:controls="using:ANetworkScanner.App.Controls"
    Title="A Network Scanner">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <DataTemplate x:Key="ProbeCellTemplate" x:DataType="vm:ProbeCell">
                <Grid Width="{x:Bind Column.Width, Mode=OneWay}" VerticalAlignment="Center">
                    <Border Visibility="{x:Bind IsPill, Mode=OneWay}"
                            HorizontalAlignment="Left"
                            CornerRadius="11"
                            Padding="10,3,10,4"
                            MaxWidth="{x:Bind PillMaxWidth, Mode=OneWay}"
                            Background="{x:Bind Background, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Text, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                   Foreground="{x:Bind Foreground, Mode=OneWay}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Visibility="{x:Bind IsPlain, Mode=OneWay}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Bind Text, Mode=OneWay}"
                               Foreground="{x:Bind Foreground, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="HostRowTemplate" x:DataType="vm:HostRow">
                <StackPanel Orientation="Horizontal" Padding="8,0,8,0"
                            Height="{x:Bind Layout.RowHeight, Mode=OneWay}" Background="Transparent">

                    <!-- status dot with a soft halo -->
                    <Grid Width="36" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DotTooltip}">
                        <Ellipse Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0"
                                 Fill="{x:Bind DotBrush, Mode=OneWay}" Opacity="0.22" />
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Margin="7,0,0,0"
                                 Fill="{x:Bind DotBrush, Mode=OneWay}" />
                    </Grid>

                    <!-- device icon + address -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                Width="{x:Bind Layout.Address.Width, Mode=OneWay}">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                ToolTipService.ToolTip="{x:Bind DeviceTip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind DeviceGlyph, Mode=OneWay}" FontSize="14"
                                      Opacity="{x:Bind DeviceOpacity, Mode=OneWay}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" Text="{x:Bind Address}" />
                    </StackPanel>

                    <TextBlock Width="{x:Bind Layout.Name.Width, Mode=OneWay}" VerticalAlignment="Center"
                               Visibility="{x:Bind Layout.Name.IsVisible, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Opacity="{x:Bind NameOpacity, Mode=OneWay}"
                               Text="{x:Bind NameText, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind NameTip, Mode=OneWay}" />
                    <TextBlock Width="{x:Bind Layout.Rtt.Width, Mode=OneWay}" VerticalAlignment="Center"
                               Visibility="{x:Bind Layout.Rtt.IsVisible, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind RttText}" />
                    <TextBlock Width="{x:Bind Layout.Mac.Width, Mode=OneWay}" VerticalAlignment="Center"
                               Visibility="{x:Bind Layout.Mac.IsVisible, Mode=OneWay}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Mac}" />
                    <TextBlock Width="{x:Bind Layout.Vendor.Width, Mode=OneWay}" VerticalAlignment="Center"
                               Visibility="{x:Bind Layout.Vendor.IsVisible, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Opacity="{x:Bind VendorOpacity, Mode=OneWay}"
                               Text="{x:Bind VendorText, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind Vendor, Mode=OneWay}" />
                    <TextBlock Width="{x:Bind Layout.Method.Width, Mode=OneWay}" VerticalAlignment="Center"
                               Visibility="{x:Bind Layout.Method.IsVisible, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MethodText}" />

                    <ItemsControl ItemsSource="{x:Bind Cells}" ItemTemplate="{StaticResource ProbeCellTemplate}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="20" Height="20" />
                <TextBlock x:Name="TitleText" Text="A Network Scanner" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Target and commands -->
        <Grid Grid.Row="1" Margin="16,2,16,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="TargetBox"
                      Grid.Column="0"
                      HorizontalAlignment="Stretch"
                      IsEditable="True"
                      Height="40"
                      FontSize="15"
                      PlaceholderText="Target:  192.168.1.0/24   10.0.0.1-50   172.16.*.*   or a list separated by commas"
                      ItemsSource="{x:Bind ViewModel.TargetSuggestions}"
                      Text="{x:Bind ViewModel.Target, Mode=TwoWay}"
                      IsEnabled="{x:Bind NotScanning(ViewModel.IsScanning), Mode=OneWay}"
                      TextSubmitted="TargetBox_TextSubmitted" />

            <Button x:Name="ScanButton" Grid.Column="1" Height="40" MinWidth="110"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind NotScanningVisibility(ViewModel.IsScanning), Mode=OneWay}"
                    Click="ScanButton_Click" ToolTipService.ToolTip="Scan (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                    <TextBlock Text="Scan" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Grid.Column="1" Height="40" MinWidth="110"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                    Click="StopButton_Click" ToolTipService.ToolTip="Stop (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>

            <Button x:Name="ExportButton" Grid.Column="2" Height="40" ToolTipService.ToolTip="Export results" AutomationProperties.Name="Export results"
                    IsEnabled="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                <FontIcon Glyph="&#xE74E;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Export as CSV…" Click="ExportCsv_Click" />
                        <MenuFlyoutItem Text="Export as JSON…" Click="ExportJson_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button x:Name="PluginsButton" Grid.Column="3" Height="40" ToolTipService.ToolTip="Service probes" AutomationProperties.Name="Service probes"
                    Click="PluginsButton_Click">
                <FontIcon Glyph="&#xEA86;" FontSize="16" />
            </Button>

            <Button x:Name="OptionsButton" Grid.Column="4" Height="40" ToolTipService.ToolTip="Options" AutomationProperties.Name="Options"
                    Click="OptionsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Margin="2,0,0,-16" FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </Grid>

        <!-- Subnet map -->
        <Grid Grid.Row="2" Margin="16,12,16,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <InfoBar x:Name="VendorBar" Severity="Informational" IsOpen="False" IsClosable="True"
                         Title="The MAC vendor list is out of date" Closed="VendorBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Name="VendorUpdateButton" Content="Update now" Click="VendorUpdate_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ProblemsBar" Severity="Warning" IsOpen="False" IsClosable="True"
                         Title="Some probe files were skipped" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10,14,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="ScanDot" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                     VerticalAlignment="Center" Opacity="0.25" />
                            <TextBlock Text="Network map" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="MapHover" HorizontalAlignment="Right" FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="32">
                        <controls:SubnetMap x:Name="Map" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        <TextBlock x:Name="MapEmpty" Text="Every square is one address. Start a scan to watch hosts light up."
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Results and details -->
        <Grid x:Name="BodyGrid" Grid.Row="3" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="DetailsColumn" Width="380" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="0,6,0,0">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="ResultsGrid" MinWidth="700">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Height="38" Padding="14,0,14,0" />
                            </Border>

                            <ListView x:Name="ResultsList"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.Rows}"
                                      ItemTemplate="{StaticResource HostRowTemplate}"
                                      SelectionMode="Single"
                                      SelectionChanged="ResultsList_SelectionChanged"
                                      RightTapped="ResultsList_RightTapped"
                                      DoubleTapped="ResultsList_DoubleTapped"
                                      IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="6,1,6,1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="False" />
                                        <AddDeleteThemeTransition />
                                        <ContentThemeTransition />
                                        <ReorderThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                            </ListView>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind NoResultsVisibility(ViewModel.HasResults, ViewModel.IsScanning), Mode=OneWay}">
                        <FontIcon Glyph="&#xE774;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No hosts yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Enter a target above and press Scan." HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14,16,14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DetailsTitle" Text="Details" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas" />

                    <StackPanel x:Name="DetailsActions" Grid.Row="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                        <Button Click="CopyIp_Click" ToolTipService.ToolTip="Copy IP address" AutomationProperties.Name="Copy IP address">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="IP" /></StackPanel>
                        </Button>
                        <Button Click="CopyMac_Click" ToolTipService.ToolTip="Copy MAC address" AutomationProperties.Name="Copy MAC address">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="MAC" /></StackPanel>
                        </Button>
                        <Button x:Name="BrowserButton" Click="OpenBrowser_Click" ToolTipService.ToolTip="Open in browser" AutomationProperties.Name="Open in browser">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                        </Button>
                        <Button x:Name="RdpButton" Click="OpenRdp_Click" ToolTipService.ToolTip="Remote Desktop" AutomationProperties.Name="Remote Desktop">
                            <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailsText"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   LineHeight="19"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Select a host to see everything the scan learned about it." />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="20,0,20,0" Height="34" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <ProgressBar Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                       Text="{x:Bind ViewModel.CountsText, Mode=OneWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" MinWidth="56" TextAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" />
        </Grid>

    </Grid>

</Window>
