<Window
    x:Class="ANetworkScanner.App.Views.PluginsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ANetworkScanner.App.ViewModels"
    xmlns:eng="using:ANetworkScanner.Engine.Probes"
    Title="Service probes">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="PluginTemplate" x:DataType="vm:PluginItem">
                <Grid Padding="12,8,8,8" ColumnSpacing="12" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind OriginText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind PortsText}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" MinWidth="0" Margin="0" VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Enabled" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProblemTemplate" x:DataType="eng:ProbeProblem">
                <Grid ColumnSpacing="8" Padding="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind File}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Tag="{x:Bind FullPath}" Click="OpenProblem_Click"
                            VerticalAlignment="Top" Padding="10,3" FontSize="12" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/AppIcon.png" Width="20" Height="20" />
                <TextBlock Text="Service probes" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="1" Margin="16,0,16,8" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" Margin="16,0,16,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource CardStyle}" Padding="0,12,0,8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0,12,0">
                        <Button Click="Add_Click" ToolTipService.ToolTip="Add a probe file you already have">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add…" /></StackPanel>
                        </Button>
                        <Button Click="New_Click" ToolTipService.ToolTip="Create a new probe from a template">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="New" /></StackPanel>
                        </Button>
                        <Button Click="Folder_Click" ToolTipService.ToolTip="Open the folder with your own probes" AutomationProperties.Name="Open probes folder">
                            <FontIcon Glyph="&#xE838;" FontSize="13" />
                        </Button>
                        <Button Click="Reload_Click" ToolTipService.ToolTip="Read the probe files again" AutomationProperties.Name="Reload">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <TextBox x:Name="FilterBox" Grid.Row="1" Margin="12,0,12,0" PlaceholderText="Filter probes"
                             TextChanged="FilterBox_TextChanged" />

                    <ListView x:Name="PluginList" Grid.Row="2"
                              ItemsSource="{x:Bind Items}"
                              ItemTemplate="{StaticResource PluginTemplate}"
                              SelectionMode="Single"
                              SelectionChanged="PluginList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                    </ListView>

                    <Expander x:Name="SkippedExpander" Grid.Row="3" Margin="12,0,12,0" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="SkippedTitle" />
                            </StackPanel>
                        </Expander.Header>
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProblemList" ItemTemplate="{StaticResource ProblemTemplate}" />
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock x:Name="NothingSelected" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Select a probe to see how it works."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="24,20,24,24" Spacing="14">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailOrigin" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Id" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="FactId" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="1" Text="Ports" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="FactPorts" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="2" Text="File" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="FactFile" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" />
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="WHAT IT SENDS AND READS" Style="{StaticResource SectionLabel}" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,10">
                                    <TextBlock x:Name="StepsText" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="20"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="HOW IT DECIDES THE RESULT" Style="{StaticResource SectionLabel}" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,10">
                                    <TextBlock x:Name="MatchText" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="20"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="Edit_Click" AutomationProperties.Name="Open probe file">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Open file" /></StackPanel>
                                </Button>
                                <Button Click="ShowInFolder_Click" AutomationProperties.Name="Show probe in folder">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;" FontSize="13" /><TextBlock Text="Show in folder" /></StackPanel>
                                </Button>
                                <Button x:Name="DuplicateButton" Click="Duplicate_Click" AutomationProperties.Name="Customize this probe"
                                        ToolTipService.ToolTip="Copy this probe to your own folder, where you can edit it. The copy replaces the built-in one.">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Customize a copy" /></StackPanel>
                                </Button>
                                <Button x:Name="DeleteButton" Click="Delete_Click" AutomationProperties.Name="Delete probe">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete" /></StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TRY IT ON A HOST" Style="{StaticResource SectionLabel}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TestAddress" AutomationProperties.Name="Test address" PlaceholderText="IPv4 address, e.g. 192.168.1.10"
                                                 KeyDown="TestAddress_KeyDown" />
                                        <Button x:Name="TestButton" Grid.Column="1" Click="Test_Click" MinWidth="110" AutomationProperties.Name="Run test on host"
                                                Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                <TextBlock Text="Run test" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ProgressBar x:Name="TestProgress" IsIndeterminate="True" Visibility="Collapsed" />
                                    <TextBlock x:Name="TestResult" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
